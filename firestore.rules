rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check endpoint for connection validation
    match /test/connection {
      allow get: if true;
    }

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'jahanvigoyal2002@gmail.com' ||
        request.auth.token.email == 'admin@nrityasana.com'
      );
    }

    // --- Entity Validation Helpers ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'phone', 'bio', 'danceStyle', 'experienceLevel', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 128 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('danceStyle' in data) || (data.danceStyle is string && data.danceStyle.size() <= 100)) &&
        (!('experienceLevel' in data) || (data.experienceLevel is string && data.experienceLevel.size() <= 50)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'currentStreak', 'totalMinutes', 'completedSessions', 'weeklyGoal']) &&
        data.keys().hasOnly(['userId', 'currentStreak', 'totalMinutes', 'completedSessions', 'weeklyGoal', 'completedDays', 'lastPracticeDate', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.currentStreak is number &&
        data.totalMinutes is number &&
        data.completedSessions is number &&
        data.weeklyGoal is number &&
        (!('completedDays' in data) || (data.completedDays is string && data.completedDays.size() <= 50)) &&
        (!('lastPracticeDate' in data) || (data.lastPracticeDate is string && data.lastPracticeDate.size() <= 30)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidPracticeLog(data) {
      return data.keys().hasAll(['id', 'userId', 'practiceId', 'title', 'discipline', 'minutesPracticed', 'completedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'practiceId', 'title', 'discipline', 'minutesPracticed', 'completedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.practiceId is string && data.practiceId.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.discipline is string && data.discipline.size() <= 50 &&
        data.minutesPracticed is number &&
        data.completedAt is string && data.completedAt.size() <= 50;
    }

    function isValidMediaItem(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'url']) &&
        data.keys().hasOnly(['id', 'userId', 'name', 'type', 'url', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() <= 200 &&
        data.type is string && (data.type == 'photo' || data.type == 'video') &&
        data.url is string && data.url.size() <= 2000 &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidAIGeneration(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'prompt', 'resultUrl', 'resultText', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.type is string && data.type.size() <= 50 &&
        (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 1000)) &&
        (!('resultUrl' in data) || (data.resultUrl is string && data.resultUrl.size() <= 2000)) &&
        (!('resultText' in data) || (data.resultText is string && data.resultText.size() <= 5000)) &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidLiveClass(data) {
      return data.keys().hasAll(['id', 'title', 'startTime', 'durationMinutes', 'meetingUrl']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'startTime', 'durationMinutes', 'meetingUrl', 'createdBy', 'participantCount', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.startTime is string && data.startTime.size() <= 50 &&
        data.durationMinutes is number &&
        data.meetingUrl is string && data.meetingUrl.size() <= 500 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128)) &&
        (!('participantCount' in data) || data.participantCount is number) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidClassAttendee(data) {
      return data.keys().hasAll(['classId', 'userId']) &&
        data.keys().hasOnly(['classId', 'userId', 'userEmail', 'joinedAt']) &&
        data.classId is string && data.classId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 128)) &&
        (!('joinedAt' in data) || (data.joinedAt is string && data.joinedAt.size() <= 50));
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'senderId', 'recipientId', 'text', 'sentAt']) &&
        data.keys().hasOnly(['id', 'senderId', 'senderEmail', 'senderRole', 'recipientId', 'recipientEmail', 'text', 'type', 'mediaUrl', 'voiceDuration', 'sentAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.senderId is string && data.senderId.size() <= 128 &&
        data.recipientId is string && data.recipientId.size() <= 128 &&
        data.text is string && data.text.size() <= 2000 &&
        data.sentAt is string && data.sentAt.size() <= 50 &&
        (!('senderEmail' in data) || (data.senderEmail is string && data.senderEmail.size() <= 128)) &&
        (!('senderRole' in data) || (data.senderRole is string && data.senderRole.size() <= 20)) &&
        (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 128)) &&
        (!('type' in data) || (data.type is string && data.type.size() <= 20)) &&
        (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1024)) &&
        (!('voiceDuration' in data) || data.voiceDuration is number);
    }

    // --- User Scoped Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();

      match /profile/main {
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          isValidUserProfile(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          incoming().userId == existing().userId &&
          isValidUserProfile(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /progress/stats {
        allow get: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) &&
          incoming().userId == request.auth.uid &&
          isValidUserProgress(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          incoming().userId == existing().userId &&
          isValidUserProgress(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /practice_logs/{logId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(logId) &&
          incoming().userId == request.auth.uid &&
          isValidPracticeLog(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(logId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          isValidPracticeLog(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(logId);
      }

      match /media/{mediaId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(mediaId) &&
          incoming().userId == request.auth.uid &&
          isValidMediaItem(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(mediaId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          isValidMediaItem(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(mediaId);
      }

      match /ai_generations/{genId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isOwner(userId) &&
          isValidId(genId) &&
          incoming().userId == request.auth.uid &&
          isValidAIGeneration(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(genId) &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          isValidAIGeneration(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(genId);
      }
    }

    // --- Live Classes ---
    match /live_classes/{classId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin() && isValidId(classId) && isValidLiveClass(incoming());
      allow update: if (
        (isAdmin() && isValidId(classId) && incoming().id == existing().id && isValidLiveClass(incoming())) ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['participantCount']) && incoming().participantCount is number)
      );
      allow delete: if isAdmin() && isValidId(classId);

      match /attendees/{attendeeUserId} {
        allow get: if isSignedIn() && (request.auth.uid == attendeeUserId || isAdmin());
        allow list: if isSignedIn();
        allow create: if isSignedIn() &&
          isValidId(attendeeUserId) &&
          request.auth.uid == attendeeUserId &&
          incoming().userId == request.auth.uid &&
          incoming().classId == classId &&
          isValidClassAttendee(incoming());
        allow delete: if isSignedIn() &&
          isValidId(attendeeUserId) &&
          (request.auth.uid == attendeeUserId || isAdmin());
      }
    }

    // --- Chat Messages ---
    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && (
        existing().senderId == request.auth.uid ||
        existing().recipientId == request.auth.uid ||
        existing().recipientId == 'all' ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidId(messageId) &&
        incoming().senderId == request.auth.uid &&
        isValidChatMessage(incoming());
      allow update: if (isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid)) &&
        isValidId(messageId) &&
        incoming().id == existing().id &&
        incoming().senderId == existing().senderId &&
        isValidChatMessage(incoming());
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // --- Admin Registry ---
    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if false; // Admins managed only via trusted backend or console
    }
  }
}
